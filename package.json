{
  "name": "koinonia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:worker": "wrangler dev",
    "dev:lms": "vite --config lms-frontend/vite.config.ts",
    "build:lms": "vite build --config lms-frontend/vite.config.ts",
    "deploy": "npm run build:lms && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply koinonia-lms-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply koinonia-lms-db --remote",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p lms-frontend/tsconfig.json"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "drizzle-orm": "^0.36.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250924.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wrangler": "^3.90.0"
  }
}
